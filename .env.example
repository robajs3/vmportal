# ============================================================================
# vmportal — konfiguracja. Skopiuj do .env (cp .env.example .env) i uzupełnij.
# .env jest w .gitignore — NIGDY nie commituj prawdziwych haseł.
#
# Hasła/klucze generuj np.:  openssl rand -hex 24
# Zalecane znaki [A-Za-z0-9] (hex) — unikasz problemów z `$` w docker compose.
# ============================================================================

# --- PostgreSQL (superużytkownik; używa go też Guacamole) -------------------
POSTGRES_USER=pguser
POSTGRES_PASSWORD=

# --- Baza aplikacji (Flask) -------------------------------------------------
APP_DB_USER=vmportal_app
APP_DB_PASSWORD=
# APP_DB_NAME=app_db

# --- Flask ------------------------------------------------------------------
# Klucz podpisujący sesje: openssl rand -hex 32
SECRET_KEY=
# Konto administratora portalu (tworzone przy pierwszym starcie aplikacji)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Guacamole --------------------------------------------------------------
# Login/hasło admina Guacamole. Przy świeżej bazie ustawiane automatycznie przez
# db-init/01-run-guacamole-schema.sh; portal używa ich do tworzenia połączeń VNC.
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=
# GUACAMOLE_PUBLIC_URL=/vmka1/guacamole/
# GUAC_INTERNAL_URL=http://guacamole:8080/guacamole
# GUAC_GRANT_USERS=

# --- Maszyny wirtualne / libvirt --------------------------------------------
# VM_HOST=host.docker.internal
# GID grupy hosta z dostępem do socketu libvirt (getent group libvirt)
LIBVIRT_GID=979

# --- SSO (LoginHub) — DOKŁADNIE ta sama wartość co SSO_SECRET w .env LoginHub
SSO_SECRET=
HUB_INTERNAL_URL=http://hub-web:8000
