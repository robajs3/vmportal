# ============================================================================
# vmportal — konfiguracja. Skopiuj do .env (cp .env.example .env) i uzupełnij.
# .env jest w .gitignore — NIGDY nie commituj prawdziwych haseł.
#
# Hasła/klucze generuj np.:  openssl rand -hex 24
# Zalecane znaki [A-Za-z0-9] (hex) — unikasz problemów z `$` w docker compose.
# ============================================================================

# --- PostgreSQL (superużytkownik; używa go też Guacamole) -------------------
POSTGRES_USER=pguser
POSTGRES_PASSWORD=

# --- Baza aplikacji (Flask) -------------------------------------------------
APP_DB_USER=vmportal_app
APP_DB_PASSWORD=
# APP_DB_NAME=app_db

# --- Flask ------------------------------------------------------------------
# Klucz podpisujący sesje: openssl rand -hex 32
SECRET_KEY=
# Konto administratora portalu (tworzone przy pierwszym starcie aplikacji)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Guacamole --------------------------------------------------------------
# Login/hasło admina Guacamole. Przy świeżej bazie ustawiane automatycznie przez
# db-init/01-run-guacamole-schema.sh; portal używa ich do tworzenia połączeń VNC.
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=
# GUACAMOLE_PUBLIC_URL=/vmka1/guacamole/
# GUAC_INTERNAL_URL=http://guacamole:8080/guacamole
# GUAC_GRANT_USERS=

# --- Maszyny wirtualne / libvirt --------------------------------------------
# VM_HOST=host.docker.internal
# GID grupy hosta z dostępem do socketu libvirt (getent group libvirt)
LIBVIRT_GID=979
# Maksymalny rozmiar ISO wgrywanego przez portal (MB). Pamiętaj o limicie body / timeoutach
# w nginxie hosta, który stoi przed tym stackiem (client_max_body_size, proxy_*_timeout).
# MAX_ISO_MB=10240

# --- SSO (LoginHub) — DOKŁADNIE ta sama wartość co SSO_SECRET w .env LoginHub
SSO_SECRET=
HUB_INTERNAL_URL=http://hub-web:8000

# --- Przeglądarki (neko + Chromium w kontenerach) ---------------------------
# Najpierw zbuduj obrazy:  docker compose --profile build build
# Uprawnienia do wolumenu wtyczek zapewnia uid 1000 (flask i neko działają jako 1000).
# Fizyczny RAM przeznaczony na wszystkie sesje (wspólna pula obu użytkowników)
# BROWSER_POOL_RAM_MB=4096
# Ile razy suma limitów sesji może przekroczyć pulę (przeglądarki rzadko zużywają cały limit)
# BROWSER_OVERCOMMIT=1.5
# BROWSER_DEFAULT_RAM_MB=768
# BROWSER_MAX_RAM_MB=2048
# Publiczny adres IP serwera dla WebRTC (puste = neko wykryje sam)
# BROWSER_PUBLIC_IP=
# Porty WebRTC: po jednym na działającą sesję, UDP i TCP - przekieruj/odblokuj je na routerze i firewallu hosta
# BROWSER_RTC_PORT_MIN=52000
# BROWSER_RTC_PORT_MAX=52099
# Klatki na sekundę podglądu (mniej = mniejsze zużycie CPU)
# BROWSER_FPS=15
# 1 = admin może też otwierać cudze sesje (domyślnie: tylko właściciel; admin może zatrzymać/usunąć)
# BROWSER_ADMIN_CAN_VIEW=0

